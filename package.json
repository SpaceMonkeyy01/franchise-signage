{
  "name": "franchise-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Franchise by Signage — co-branded signage workflow portal",
  "scripts": {
    "dev": "concurrently -n db,web -c magenta,cyan \"npm:dev:db\" \"next dev\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:verify": "tsx scripts/verify-schema.ts",
    "seed": "tsx scripts/seed.ts",
    "dev:db": "tsx scripts/dev-db-server.ts",
    "dev:web": "next dev",
    "smoke": "node scripts/smoke.mjs",
    "dev:db:reset": "tsx scripts/dev-db-server.ts --reset",
    "sla": "tsx scripts/run-sla.ts"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.6.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "16.3.0",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.1.2",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.4",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "supabase": "^2.114.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
