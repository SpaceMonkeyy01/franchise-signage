# Franchise by Signage — environment. Copy to .env.local and fill in.
# .env* is gitignored; this example file is the only one that is committed.

# --- Supabase -----------------------------------------------------------------
# From Project Settings → API. None of this is needed for local development:
# `npm run dev` runs a PGlite-backed Postgres and needs no Supabase at all.
# See docs/SUPABASE.md for standing a project up.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Bypasses RLS. Server-only — never ship it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# The PRIVATE Storage bucket that holds uploads (SPEC §5.5). Setting this selects
# the Supabase driver; leaving it empty keeps files on local disk under
# .storage/. There is no fallback either way — a misconfigured bucket must fail
# loudly rather than write a lease exhibit to a container that is thrown away.
# See docs/SUPABASE.md for creating it.
SUPABASE_STORAGE_BUCKET=

# Direct Postgres connection, used by `npm run migrate` and `npm run seed`
# (the app itself talks to this too — see src/lib/db/pool.ts). Supabase prints it
# under Project Settings → Database. Leave unset to use the local dev database.
DATABASE_URL=

# --- Resend -------------------------------------------------------------------
RESEND_API_KEY=
# Fallback sender. Franchisee-facing mail is sent AS the brand (SPEC §8d).
RESEND_FROM_EMAIL=noreply@signage.com

# --- App ----------------------------------------------------------------------
# Absolute origin used to build the tokenized links that go out in email.
APP_URL=http://localhost:3000

# --- DID generator (SPEC §8c, Session 8) --------------------------------------
# Placeholder fee: $499. Deliberately config, not a constant — the real amount
# is an open question. Per-brand overrides live in brands.did_fee_cents.
DID_FEE_CENTS=49900
