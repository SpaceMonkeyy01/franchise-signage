# Build-time environment variables (Vite). Anything prefixed VITE_ is inlined
# into the bundle at build time. Resolved in src/json/apiConfig.js, falling back
# to the committed default in src/json/API.json when unset.

# The Laravel API — auth plus all studio pricing/mockup endpoints. Already a
# production URL in API.json (https://api.signize.ai/api); only set this to
# override it.
# VITE_BACKEND_API_URL=https://api.signize.ai/api

# DEV ONLY (put these in .env.development.local, which is gitignored).
# Service account used so seeded mock users can reach the live Signize API for
# pricing/mockups without a real backend account. See src/utils/devBackendAuth.js
# — this is also the pattern to reuse for a headless server-side integration.
# VITE_DEV_BACKEND_EMAIL=
# VITE_DEV_BACKEND_PASSWORD=
